SCHEMA_NAME=tradingsystem
AUTH_SCHEMA_NAME=authentication

APPLY_COMMAND='for migration in migrations/*.sql; do
    psql -h "${PGHOST:-localhost}" \
         -p "${PGPORT:-5432}" \
         -U "${PGUSER:-postgres}" \
         -d "$TARGET_DATABASE" \
         -v ON_ERROR_STOP=1 \
         -f "$migration"
done'

ACCOUNTS_TABLE=tradingsystem.accounts
ACCOUNTS_STATUS_COLUMN=status

ACCOUNTS_STATUS_ACTIVE=ACTIVE
ACCOUNTS_STATUS_SUSPENDED=SUSPENDED
ACCOUNTS_STATUS_CLOSED=CLOSED

ORDERS_TABLE=tradingsystem.orders
ORDERS_IDEMPOTENCY_COLUMN=idempotency_key