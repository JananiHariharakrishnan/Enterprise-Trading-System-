# Database/Postgres Configuration Template
# Copy this file to .env and fill in your local secrets

# =========================================================
# Database Configuration
# =========================================================
# Target database name for migrations and seed data
POSTGRES_DB=trading

# PostgreSQL connection details
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Optional: Override via environment variables
# export TARGET_DATABASE=trading
# export PGHOST=localhost
# export PGPORT=5432
# export PGUSER=postgres
# export PGPASSWORD=your_password

