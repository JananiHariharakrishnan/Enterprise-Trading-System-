# Save the env file as .env.local and fill in the secrets for local development.
# Server Configuration
NODE_ENV=development
PORT=3000

# JWT Configuration
# Replace with a strong random secret for local development
JWT_SECRET=your-local-jwt-secret
JWT_ISSUER=auth-service

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/trading

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password