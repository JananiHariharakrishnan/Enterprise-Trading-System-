{
  "name": "trade-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --coverage --coverage-exclude=src/app/generated/**",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "generate:contracts": "npm run generate:contracts:clean && npm run generate:contracts:auth && npm run generate:contracts:trade",
    "generate:contracts:clean": "node -e \"const fs=require('node:fs'); fs.rmSync('src/app/generated/auth',{recursive:true,force:true}); fs.rmSync('src/app/generated/trade',{recursive:true,force:true});\"",
    "generate:contracts:auth": "openapi-generator-cli generate --generator-key auth-client",
    "generate:contracts:trade": "openapi-generator-cli generate --generator-key trade-client"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@analogjs/vitest-angular": "^2.7.5",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
