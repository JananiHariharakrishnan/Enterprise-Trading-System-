# ETL Sprint 4: Analytics and Ingestion Pipeline
# Copy this file to .env and fill in your local secrets

# =========================================================
# Fauxnance API Configuration
# =========================================================
# API key for market data - get from Fauxnance
# CRITICAL: Never commit the real key to git
# The key is read from FAUXNANCE_API_KEY and from nowhere else
FAUXNANCE_API_KEY=change_me

# =========================================================
# Optional: Cache and output paths
# =========================================================
# Location for caching raw API responses
# CACHE_PATH=.cache

# Output path for dashboard
# DASHBOARD_OUTPUT=artefacts/market_dashboard.html

