# ETL Sprint 7: Incremental ETL for FACT_TRADES
# Copy this file to .env and fill in your local configuration

# =========================================================
# Database Configuration
# =========================================================
# PostgreSQL connection string for operational database
PG_CONN=postgresql+psycopg2://postgres:change_me@localhost:5432/trading

# =========================================================
# Analytics Database Configuration
# =========================================================
# Path to DuckDB analytics database file
ANALYTICS_DATABASE_PATH=analytics.duckdb

# =========================================================
# ETL Data Paths
# =========================================================
# Extracted orders from PostgreSQL (before transform)
EXTRACTED_ORDERS_PATH=data/extracted_orders.csv

# Valid orders after transformation
VALID_ORDERS_PATH=data/valid_orders.csv

# Invalid orders (error rows)
INVALID_ORDERS_PATH=data/invalid_orders.csv

