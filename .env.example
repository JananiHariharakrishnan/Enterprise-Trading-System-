# =========================================================
# CENTRALIZED DEPLOYMENT ENDPOINTS (4 CORE URLS)
# =========================================================
# 1. FRONTEND_API_URL: Browser-accessible Trade REST API endpoint
#    Local dev: http://localhost:8081
#    Remote deploy: http://<PUBLIC_HOST>:8081 (or http://<PUBLIC_HOST>:4200/_order if using reverse proxy)
FRONTEND_API_URL=http://localhost:8081

# 2. AUTH_API_URL: Browser-accessible Auth Service endpoint
#    Local dev: http://localhost:3000
#    Remote deploy: http://<PUBLIC_HOST>:3000 (or http://<PUBLIC_HOST>:4200/_auth if using reverse proxy)
AUTH_API_URL=http://localhost:3000

# 3. KAFKA_BOOTSTRAP_SERVERS: Kafka broker address for backend services
#    Docker Compose: kafka:29092
#    Local host dev: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# 4. DATABASE_URL: AWS RDS PostgreSQL JDBC connection URL
DATABASE_URL=jdbc:postgresql://your-rds-endpoint.amazonaws.com:5432/trading

# =========================================================
# Compose Orchestration & Directories
# =========================================================
COMPOSE_PROJECT_NAME=trading-platform
COMPOSE_PROFILES=frontend,auth-service,order-service,executor-service,kafka

PUBLIC_HOST=localhost
FRONTEND_PORT=4200
AUTH_SERVICE_PORT=3000
ORDER_SERVICE_PORT=8081
EXECUTOR_SERVICE_PORT=8082

AUTH_SERVICE_DIR=./Services/auth-service
ORDER_SERVICE_DIR=./Services/trade-api
EXECUTOR_SERVICE_DIR=./Services/trade-executor
FRONTEND_DIR=./Frontend/trade-ui

ORDER_SERVICE_HEALTH_PATH=/health
# Optional override for nginx proxy rewrites; defaults to AUTH_API_URL and FRONTEND_API_URL
# FRONTEND_URL_REWRITES=http://localhost:3000=http://localhost:4200/_auth http://localhost:8081=http://localhost:4200/_order

# =========================================================
# Database Individual Connection Properties (RDS / PostgreSQL)
# =========================================================
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=trading
DB_USER=your_db_username
DB_PASSWORD=your_secure_db_password
POSTGRES_DB=trading
POSTGRES_HOST=your-rds-endpoint.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_secure_db_password
DB_URL=jdbc:postgresql://your-rds-endpoint.amazonaws.com:5432/trading
DB_DRIVER=org.postgresql.Driver

# =========================================================
# Authentication & JWT
# =========================================================
JWT_SECRET=your_32_character_minimum_jwt_secret_here
JWT_ISSUER=auth-service
INTERNAL_SERVICE_TOKEN=your_internal_service_token_here

# =========================================================
# Kafka Configuration
# =========================================================
KAFKA_TOPICS=orders:3:604800000 orders.DLT:3:604800000 trade-events:3:2592000000 trade-events.DLT:3:2592000000 trade-signals:3:604800000 trade-signals.DLT:3:604800000 market-data:6:86400000 market-data.DLT:6:86400000
KAFKA_CONSUMER_GROUP_ID=trade-executor

# =========================================================
# Inter-Service Communication (Internal Docker Network)
# =========================================================
AUTH_SERVICE_URL=http://auth-service:3000
AUTH_URL=http://auth-service:3000
TRADE_API_URL=http://order-service:8081/api/v1
TRADE_API_BASE_URL=http://order-service:8081

# =========================================================
# Fauxnance External Market Data API
# =========================================================
FAUXNANCE_API_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1/
FAUXNANCE_API_KEY=your_fauxnance_api_key_here
FAUXNANCE_TIMEOUT_SECONDS=5
FAUXNANCE_MAX_RETRIES=3
FAUXNANCE_RETRY_DELAY_MS=1000

# =========================================================
# Email / Notification Configuration (SMTP)
# =========================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM=your-email@gmail.com
MAIL_ENABLED=true

# =========================================================
# AI / LLM Configuration
# =========================================================
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite