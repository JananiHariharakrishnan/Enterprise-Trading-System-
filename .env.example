# Copy this file to .env and fill in your local secrets
# The repository-root .env is loaded by docker-compose.yml and consumed by all services

# =========================================================
# Database Configuration
# =========================================================
POSTGRES_DB=trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# =========================================================
# JWT / Authentication
# =========================================================
# Shared JWT secret used by auth-service to sign tokens and trade-api to verify them
# CRITICAL: Change this in production. This value is published in .env.example as a development fixture.
# See SECURITY_REVIEW.md for the decision on key rotation.
JWT_SECRET=development-only-shared-secret-change-me

# The issuer claim embedded in tokens signed by auth-service
# trade-api will only accept tokens with this issuer value
JWT_ISSUER=auth-service

# =========================================================
# Kafka Configuration
# =========================================================
KAFKA_BOOTSTRAP_SERVERS=<ip_address>:9092

# =========================================================
# Service Ports
# =========================================================
# Auth Service runs on port 3000 (reserved by infra/README.md)
# Trade API runs on port 8081
# Trade Executor runs on port 8082 (different container)
