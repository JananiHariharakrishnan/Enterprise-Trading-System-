# Copy this file to .env and fill in your local secrets
# The repository-root .env is loaded by docker-compose.yml and consumed by all services

# =========================================================
# Database Configuration
# =========================================================
POSTGRES_DB=trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# =========================================================
# JWT / Authentication
# =========================================================

JWT_SECRET=development-only-shared-secret-change-me


JWT_ISSUER=auth-service

# =========================================================
# Kafka Configuration
# =========================================================
KAFKA_BOOTSTRAP_SERVERS=your-ip:9092

# Copy this file to .env and fill in secrets for local development.


DB_URL=jdbc:postgresql://localhost:5432/trading
DB_USER=postgres
DB_PASSWORD=your-password
DB_DRIVER=org.postgresql.Driver

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=your-ip:9092

# Fauxnance API Configuration
FAUXNANCE_API_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1/
FAUXNANCE_API_KEY=your-key
FAUXNANCE_TIMEOUT_SECONDS=5
FAUXNANCE_MAX_RETRIES=3
FAUXNANCE_RETRY_DELAY_MS=1000

# =========================================================
# SMTP server host and port (default is Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# The sender email address
MAIL_USERNAME=your-email@gmail.com
# For Gmail, generate a 16-character App Password (not your account password):
# Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_PASSWORD=your-password
# Optional sender address (defaults to MAIL_USERNAME)
MAIL_FROM=your-email@gmail.com
MAIL_ENABLED=true

LLM_API_KEY=your-key
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

TRADE_API_URL=trade-url
AUTH_URL=auth-url