# NON-SECRET settings for auth / order / executor (ConfigMap etp-config). Edit, then kubectl apply -k k8s/.build:
# the ConfigMap name carries a hash, so pods restart by themselves when this file changes.
# Anything not set here falls back to Config/application.yml (shared, mounted at /config).
# Secrets (DB_PASSWORD, JWT_SECRET, API keys) are NOT here: see secrets.env.

# ---- database (this deployment uses the existing RDS instance) ----
DB_HOST=database-1.cxmsqmiikfsx.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=trading
DB_USER=postgres
DB_SCHEMA_TRADE=tradingsystem
DB_SCHEMA_AUTH=authentication
DB_SSL=true
PGSSLMODE=require
JDBC_PARAMS=&sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://database-1.cxmsqmiikfsx.ap-south-1.rds.amazonaws.com:5432/trading?currentSchema=tradingsystem,public&sslmode=require
POSTGRES_HOST=database-1.cxmsqmiikfsx.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=postgres
DB_URL=jdbc:postgresql://database-1.cxmsqmiikfsx.ap-south-1.rds.amazonaws.com:5432/trading
DATABASE_URL=jdbc:postgresql://database-1.cxmsqmiikfsx.ap-south-1.rds.amazonaws.com:5432/trading
DB_DRIVER=org.postgresql.Driver

# ---- kafka (the StatefulSet in kafka.yaml) ----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_MAX_BLOCK_MS=3000
TRADE_EVENTS_TOPIC=trade-events
MARKET_DATA_TOPIC=market-data
KAFKA_TOPICS=orders:3:604800000 orders.DLT:3:604800000 trade-events:3:2592000000 trade-events.DLT:3:2592000000 trade-signals:3:604800000 trade-signals.DLT:3:604800000 market-data:6:86400000 market-data.DLT:6:86400000
KAFKA_CONSUMER_GROUP_ID=trade-executor


# ---- ports (must match the manifests; see the header of each *-service.yaml) ----
AUTH_SERVICE_PORT=3000
ORDER_SERVICE_PORT=8081
EXECUTOR_SERVICE_PORT=8082
FRONTEND_PORT=80

# ---- security ----
JWT_ISSUER=auth-service
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=900

# ---- market data / strategies / notifications ----
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
FAUXNANCE_API_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1/
FAUXNANCE_TIMEOUT_SECONDS=5
FAUXNANCE_MAX_RETRIES=3
FAUXNANCE_RETRY_DELAY_MS=1000
POLL_INTERVAL_SECONDS=36000
MARKET_AWAIT_MS=6000
MARKET_VIEW_INTEREST_MINUTES=30
MARKET_HEALTH_FRESH_MINUTES=120
STRATEGY_SWEEP_INTERVAL_MS=15000
STRATEGY_ORDER_TIMEOUT_MS=30000
NOTIFICATION_SWEEP_INTERVAL_MS=20000
CANDLES_CACHE_SECONDS=60
ALERTS_MAX_PER_ACCOUNT=25
FUNDS_MAX_PER_MOVEMENT=1000000
ADVICE_SHORT_PERIOD=2
ADVICE_LONG_PERIOD=3
AUTOMATION_ENABLED=true
AUTOMATION_SIMULATION=false
PORTFOLIO_QUOTE_TTL_SECONDS=60
PORTFOLIO_STALE_AFTER_SECONDS=900
PORTFOLIO_PROVIDER_COOLDOWN_SECONDS=15
NOTIFICATIONS_DISPATCH_INTERVAL_MS=2000

# ---- consumer switches and groups ----
MARKET_DATA_CONSUMER_ENABLED=true
NOTIFICATIONS_CONSUMER_ENABLED=true
PORTFOLIO_CONSUMER_ENABLED=true
KAFKA_WATCHLIST_GROUP=watchlist-service
KAFKA_NOTIFICATIONS_GROUP=notification-service
KAFKA_PORTFOLIO_GROUP=portfolio-service

# ---- email (leave SMTP_HOST empty = codes are written to the auth-service log) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=Akatsuki <no-reply@example.com>
SMTP_USER=aakashkumary759@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=aakashkumary759@gmail.com
MAIL_FROM=your-email@gmail.com
MAIL_ENABLED=true

# ---- assistant (LLM) ----
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-flash-latest
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# ---- internal service addresses ----
AUTH_SERVICE_URL=http://auth-service
ORDER_SERVICE_URL=http://order-service
AUTH_URL=http://auth-service:3000
TRADE_API_URL=http://order-service:8081/api/v1
TRADE_API_BASE_URL=http://order-service:8081

# ---- browser endpoints & health paths ----
FRONTEND_API_URL=http://a99720cbee5f2476aba263a04c82f98c-1177329242.ap-south-1.elb.amazonaws.com:8081
AUTH_API_URL=http://a785f6c3aa7d04ea8966ee543cd86845-2024394357.ap-south-1.elb.amazonaws.com:3000
ORDER_SERVICE_HEALTH_PATH=/health