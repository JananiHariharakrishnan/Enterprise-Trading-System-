# Copy this file to .env and fill in secrets for local development.
# Spring reads this via: spring.config.import=optional:file:.env[.properties]

SERVER_PORT=8081

DB_URL=jdbc:postgresql://localhost:5432/trading
DB_USER=postgres
DB_PASSWORD=change_me
DB_DRIVER=org.postgresql.Driver

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=<LINUX_IP>:9092
KAFKA_CONSUMER_GROUP_ID=trade-executor
