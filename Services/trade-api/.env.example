# Copy this file to .env and fill in secrets for local development.
# Spring reads this via: spring.config.import=optional:file:.env[.properties]

SERVER_PORT=8081

DB_URL=jdbc:postgresql://localhost:5432/trading
DB_USER=postgres
DB_PASSWORD=change_me
DB_DRIVER=org.postgresql.Driver

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=<LINUX_IP>:9092
KAFKA_CONSUMER_GROUP_ID=trade-executor

# =========================================================
# Email / Notification Configuration
# =========================================================
# SMTP server host and port (default is Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# The sender email address
MAIL_USERNAME=your-email@gmail.com
# For Gmail, generate a 16-character App Password (not your account password):
# Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_PASSWORD=your-app-password
# Optional sender address (defaults to MAIL_USERNAME)
MAIL_FROM=your-email@gmail.com
MAIL_ENABLED=true
