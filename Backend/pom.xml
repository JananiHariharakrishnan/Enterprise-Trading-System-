<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tradingsystem</groupId>
    <artifactId>domain-engine</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.12.2</junit.version>
        <validation.version>3.1.1</validation.version>
        <surefire.version>3.5.3</surefire.version>
        <enforcer.version>3.6.1</enforcer.version>
    </properties>

    <dependencies>

        <!-- ONLY non-test dependency -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${validation.version}</version>
        </dependency>

        <!-- JUnit 5 - test only -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- JUnit 5 test runner -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>

            <!-- Ban forbidden dependencies -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer.version}</version>

                <executions>
                    <execution>
                        <id>ban-forbidden-dependencies</id>
                        <phase>validate</phase>

                        <goals>
                            <goal>enforce</goal>
                        </goals>

                        <configuration>
                            <rules>

                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>

                                    <message>
                                        Forbidden dependency detected.
                                        The Sprint 5 domain module must not
                                        depend on Spring, servlet APIs,
                                        JDBC drivers, MyBatis, or connection pools.
                                    </message>

                                    <excludes>

                                        <!-- Spring -->
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.boot:*</exclude>

                                        <!-- Servlet -->
                                        <exclude>jakarta.servlet:*</exclude>
                                        <exclude>javax.servlet:*</exclude>

                                        <!-- JDBC drivers -->
                                        <exclude>org.postgresql:*</exclude>
                                        <exclude>com.mysql:*</exclude>
                                        <exclude>mysql:*</exclude>

                                        <!-- MyBatis -->
                                        <exclude>org.mybatis:*</exclude>

                                        <!-- Connection pool -->
                                        <exclude>com.zaxxer:HikariCP</exclude>

                                    </excludes>
                                </bannedDependencies>

                            </rules>

                            <fail>true</fail>

                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>